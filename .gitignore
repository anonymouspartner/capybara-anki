# ---------------------------------------------------------------------------
# Anki collection exports and anything unpacked from them.
#
# An export carries the real vocabulary corpus, which is derived from two
# people's private conversations. It must never be committed — not to this
# private repo either, since git history is forever and this repo may not stay
# private. Work on exports happens in scratch/, which is ignored wholesale.
# ---------------------------------------------------------------------------
*.colpkg
*.apkg
*.anki2
*.anki21
*.anki21b
collection*.sqlite*
scratch/
media/
media.db*

# Test fixtures are synthetic collections generated by the test suite.
# They are safe, but they are build output, not source.
tests/fixtures/generated/

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
.streamlit/secrets.toml

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# ---------------------------------------------------------------------------
# Node / web
# ---------------------------------------------------------------------------
node_modules/
dist/
.wrangler/
.vercel/

# ---------------------------------------------------------------------------
# OS
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
